# ---------------------------------------------------------------------------
# TestPilot AI — environment configuration
# Copy to .env (never commit .env) or export these variables in your shell.
# All backend settings use the TESTPILOT_ prefix unless noted otherwise.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
TESTPILOT_APP_NAME=TestPilot AI
TESTPILOT_VERSION=1.0.0
# Absolute SQLite path. Inside Docker the data volume is /data.
# TESTPILOT_DATABASE_URL=sqlite:///./data/testpilot.db
# TESTPILOT_SCREENSHOT_DIR=./screenshots
# TESTPILOT_REPORT_DIR=./reports

# Browser origins allowed to call the API (JSON array).
TESTPILOT_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Test defaults ----------------------------------------------------------
TESTPILOT_DEFAULT_TIMEOUT_SECONDS=60
TESTPILOT_DEFAULT_MAX_PAGES=5
TESTPILOT_DEFAULT_MAX_LINKS=25
TESTPILOT_DEFAULT_MAX_DEPTH=1
TESTPILOT_DEFAULT_BROWSER=chromium

# --- Execution safety -------------------------------------------------------
TESTPILOT_MAX_CONCURRENCY=2
TESTPILOT_MAX_PAGES_HARD_LIMIT=25
TESTPILOT_MAX_LINKS_HARD_LIMIT=100
# Only enable for the bundled local fixture site. NEVER in production.
TESTPILOT_ALLOW_LOCAL_TARGETS=false

# --- Optional AI analysis ---------------------------------------------------
# Leave the key empty to run the deterministic rule-based analyzer.
TESTPILOT_AI_ENABLED=true
TESTPILOT_AI_PROVIDER=openai
# AI_API_KEY and OPENAI_API_KEY are also accepted as aliases.
# TESTPILOT_AI_API_KEY=
TESTPILOT_AI_BASE_URL=https://api.openai.com/v1
TESTPILOT_AI_MODEL=gpt-4o-mini
TESTPILOT_AI_TIMEOUT_SECONDS=30

# --- Frontend (build-time, optional) ---------------------------------------
# Leave empty to use same-origin /api requests (Vite dev proxy / nginx proxy).
# VITE_API_BASE=
